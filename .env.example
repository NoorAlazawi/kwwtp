# انسخ هذا الملف إلى .env واملأ القيم (لا ترفع .env إلى git)
DJANGO_SECRET_KEY=ضع-هنا-مفتاحا-عشوائيا-طويلا
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# عند الإنتاج على https (مثل PythonAnywhere):
# DJANGO_CSRF_TRUSTED_ORIGINS=https://<username>.pythonanywhere.com

# --- اختيار محرّك قاعدة البيانات: postgresql | mysql | sqlite ---
DB_ENGINE=postgresql

# --- PostgreSQL (التطوير المحلي) ---
DB_NAME=clarifier
DB_USER=clarifier
DB_PASSWORD=clarifier123
DB_HOST=localhost
DB_PORT=5432

# --- MySQL (مثال PythonAnywhere) ---
# DB_ENGINE=mysql
# DB_NAME=<username>$clarifier
# DB_USER=<username>
# DB_PASSWORD=كلمة-مرور-mysql
# DB_HOST=<username>.mysql.pythonanywhere-services.com
